{
  "name": "pga-ff-example",
  "version": "0.1.0",
  "private": true,
  "description": "Workshop: Arbitrum PGA and Fast Feed, with a local simulator and Arbitrum Sepolia. Not production.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim": "tsx sim/cli.ts",
    "feed": "tsx fast-feed/client/feed.ts",
    "pga": "tsx pga/bot/bot.ts",
    "pga:probe": "tsx pga/bot/probe.ts",
    "race": "tsx combo/scenarios.ts",
    "demo": "tsx combo/demo.ts",
    "pga:slot": "tsx combo/slot.ts",
    "traffic": "tsx sim/traffic.ts",
    "key:new": "tsx fast-feed/client/key.ts",
    "tickets:buy": "tsx fast-feed/client/tickets-cli.ts buy",
    "tickets:status": "tsx fast-feed/client/tickets-cli.ts status",
    "tickets:withdraw": "tsx fast-feed/client/tickets-cli.ts withdraw",
    "pretest": "tsx sim/build-cli.ts",
    "test": "node --import tsx --import ./shared/test/plain-env.ts --test \"*/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.57.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
